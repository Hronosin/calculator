{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "EngineeringCalculator",
  "version": "2.0.0",
  "identifier": "io.calc.engineering",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Engineering Calculator",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Modular engineering calculator",
    "longDescription": "Cross-platform engineering calculator with symbolic math, plotting, units conversion, and a plugin system."
  }
}
